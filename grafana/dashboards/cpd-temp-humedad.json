{
  "title": "CPD - Temperatura y Humedad",
  "uid": "cpd-temp-humedad",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "cpd",
    "sensirion",
    "sht4x"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatura (°C)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-cpd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 33
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "min",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"cpd_monitorizacion\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cpd_ambiente\")\n  |> filter(fn: (r) => r._field == \"temperatura_c\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"sensor_id\", \"ubicacion\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-cpd"
          }
        }
      ]
    },
    {
      "id": 2,
