# Copia este fichero a ".env" y rellena tus valores reales.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- InfluxDB ---------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=cambia_esta_contrasena
INFLUXDB_ORG=mi-empresa
INFLUXDB_BUCKET=cpd_monitorizacion
# Token de administrador que se crea la primera vez que arranca InfluxDB.
# Genera uno tú mismo, por ejemplo con: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=cambia_este_token_por_uno_generado_por_ti

# --- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia_esta_contrasena

# Token de InfluxDB de SOLO LECTURA para el datasource de Grafana (no el
# de administrador de arriba). Se crea DESPUÉS de levantar el stack:
#   influx auth create --org <tu-org> --read-bucket <id-del-bucket> \
#     --token <TOKEN_ADMIN> --description "grafana-solo-lectura"
# Ver docs/MANUAL-EXPERTO.md sección 6.
GRAFANA_INFLUXDB_TOKEN=

# Contraseña del usuario "visor" de Grafana (rol Viewer, solo consulta).
# Se crea vía API tras el primer arranque — ver docs/MANUAL-EXPERTO.md
# sección 6. Puedes dejarlo vacío hasta entonces.
GRAFANA_VIEWER_PASSWORD=

# --- SMTP (envío de alertas por email) -----------------------------------
# Datos de tu proveedor de correo. Sin esto, las reglas de alerta
# funcionan igual mostrándose en Grafana, pero no llegará ningún email.
GRAFANA_SMTP_HOST=smtp.tuproveedor.com:587
GRAFANA_SMTP_USER=alertas@tudominio.com
GRAFANA_SMTP_PASSWORD=cambia_esta_contrasena
GRAFANA_SMTP_FROM_ADDRESS=alertas@tudominio.com
