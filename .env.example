# Copia este fichero a ".env" y rellena tus valores reales.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- InfluxDB ---------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=cambia_esta_contrasena
INFLUXDB_ORG=mi-empresa
INFLUXDB_BUCKET=cpd_monitorizacion
# Token de administrador que se crea la primera vez que arranca InfluxDB.
# Genera uno tú mismo, por ejemplo con: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=cambia_este_token_por_uno_generado_por_ti

# --- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia_esta_contrasena
